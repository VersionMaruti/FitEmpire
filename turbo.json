{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": [
        "SPRING_DATASOURCE_URL",
        "SPRING_DATASOURCE_USERNAME",
        "SPRING_DATASOURCE_PASSWORD",
        "DB_NAME",
        "DB_USER",
        "DB_PASSWORD"
    ],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "lint": {}
    }
}